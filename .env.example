DATABASE_URL=postgresql+psycopg2://youtube:change_me@localhost:5432/youtube_ai
DOWNLOAD_DIR=audio/downloads
LOG_FILE=logs/app.log
SCHEDULER_INTERVAL_MINUTES=30
MAX_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
CHANNEL_SYNC_TABS=videos,shorts,streams
CHANNEL_BATCH_CHECK_INTERVAL_MINUTES=1
AUTO_ENQUEUE_CATALOG=true
CATALOG_ENQUEUE_BATCH_SIZE=20
WHISPER_CPP_BINARY=bin/whisper-cli
WHISPER_MODEL_PATH=models/whisper/ggml-small-q5_1.bin
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
WHISPER_THREADS=3
WHISPER_PROMPT=以下是普通话的句子。
TRANSCRIPT_DIR=transcripts
TRANSCRIPTION_MAX_RETRIES=3
TRANSCRIPTION_POLL_SECONDS=10
TRANSCRIPTION_TIMEOUT_SECONDS=7200
TRANSCRIPTION_STALE_MINUTES=120
# YTDLP_PROXY=http://127.0.0.1:7890
